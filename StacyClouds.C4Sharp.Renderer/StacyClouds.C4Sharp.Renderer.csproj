<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0;net11.0</TargetFrameworks>
    <Version>1.1.1</Version>
    <PackageId>StacyClouds.C4Sharp.Renderer</PackageId>
    <Description>SVG rendering for C4Sharp workspace views.</Description>
    <Authors>Stacy Cashmore</Authors>
    <Copyright>Copyright 2026</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://c4sharp.net</PackageProjectUrl>
    <RepositoryUrl>https://github.com/StacyClouds/c4sharp.net</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\StacyClouds.C4Sharp.Core\StacyClouds.C4Sharp.Core.csproj" />
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
