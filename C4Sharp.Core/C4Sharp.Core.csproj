<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ReleaseNotes>
    </ReleaseNotes>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <!-- Version is automatically calculated by MinVer based on git tags -->
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerMinimumMajorMinor>1.1</MinVerMinimumMajorMinor>
  </PropertyGroup>
  <PropertyGroup>
    <PackageId>StacyClouds.C4Sharp.Core</PackageId>
    <AssemblyName>StacyClouds.C4Sharp.Core</AssemblyName>
    <RootNamespace>StacyClouds.C4Sharp</RootNamespace>
    <Description>The core library that can used to create software architecture models using the C4 model.</Description>
    <Authors>StacyClouds</Authors>
    <Copyright>Copyright 2017-2026</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/StacyClouds/c4sharp.net</PackageProjectUrl>
    <RepositoryUrl>https://github.com/StacyClouds/c4sharp.net</RepositoryUrl>
  </PropertyGroup>
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="MinVer" Version="6.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>