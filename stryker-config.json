{
  "$schema": "https://raw.githubusercontent.com/stryker-mutator/stryker-net/master/src/Stryker.CLI/Stryker.CLI/schema/stryker-schema.json",
  "stryker-config": {
    "solution": "StacyClouds.C4Sharp.Client.Mutation.sln",
    "project": "StacyClouds.C4Sharp.Client/StacyClouds.C4Sharp.Client.csproj",
    "test-projects": [
      "StacyClouds.C4Sharp.Client.Tests/StacyClouds.C4Sharp.Client.Tests.csproj"
    ],
    "target-framework": "net8.0",
    "configuration": "Debug|x64",
    "mutation-level": "standard",
    "reporters": [
      "progress",
      "cleartext",
      "html",
      "json"
    ],
    "mutate": [
      "Api/StructurizrClient.cs",
      "Api/HashBasedMessageAuthenticationCode.cs",
      "Api/HmacAuthorizationHeader.cs",
      "Encryption/AesEncryptionStrategy.cs",
      "IO/Json/JsonReader.cs",
      "IO/Json/JsonWriter.cs",
      "IO/Json/PaperSizeJsonConverter.cs",
      "IO/Json/EncryptionStrategyJsonConverter.cs",
      "Util/WorkspaceUtils.cs"
    ],
    "thresholds": {
      "high": 90,
      "low": 80,
      "break": 80
    }
  }
}
